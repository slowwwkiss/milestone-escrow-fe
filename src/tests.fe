// Run the tests with `fe test`.
//
// The Fe 26.6 test EVM keeps `block.timestamp` constant inside one test
// and `create2` with a nonzero deployment value reverts, so the
// deadline-crossing tests use a zero lock period: the deadline is then
// exactly "now", funding is still allowed at that instant
// (timestamp <= deadline), release is closed (timestamp < deadline fails),
// and refund is open (timestamp >= deadline holds). A real deployment
// would cross the deadline by waiting; the logic is identical.

use ingot::{EscrowMsg, MilestoneEscrow}
use std::evm::{days, ether}

fn deploy(lock: Duration, client: Address, freelancer: Address) -> Address
uses (evm: mut Evm)
{
    evm.create2<MilestoneEscrow>(
        value: Wei::zero(),
        args: (client, freelancer, lock),
        salt: 0,
    )
}

fn fund(escrow: Address, value: Wei) -> Wei uses (evm: mut Evm) {
    evm.call(
        addr: escrow,
        gas: 200000,
        value,
        message: EscrowMsg::Fund {},
    )
}

fn release(escrow: Address, amount: Wei) -> Wei uses (evm: mut Evm) {
    evm.call(
        addr: escrow,
        gas: 200000,
        value: Wei::zero(),
        message: EscrowMsg::Release { amount },
    )
}

fn refund(escrow: Address, to: Address) -> Wei uses (evm: mut Evm) {
    evm.call(
        addr: escrow,
        gas: 200000,
        value: Wei::zero(),
        message: EscrowMsg::Refund { to },
    )
}

fn available(escrow: Address) -> Wei uses (evm: mut Evm) {
    evm.call(
        addr: escrow,
        gas: 100000,
        value: Wei::zero(),
        message: EscrowMsg::Available {},
    )
}

#[test(balance = 10_000_000_000_000_000_000)]
fn fund_then_release_milestones() uses (evm: mut Evm) {
    let client = evm.address()
    let freelancer = Address::new(0x1234)
    let escrow = deploy(lock: days(7), client: client, freelancer: freelancer)

    // Two top-ups: 1 ETH then 2 ETH.
    assert!(fund(escrow, value: ether(1)) == ether(1))
    assert!(fund(escrow, value: ether(2)) == ether(3))
    assert!(available(escrow) == ether(3))
    assert!(evm.balance(escrow) == ether(3))

    // Milestone 1: 1 ETH to the freelancer.
    assert!(release(escrow, amount: ether(1)) == ether(1))
    assert!(evm.balance(freelancer) == ether(1))
    assert!(available(escrow) == ether(2))

    // Milestone 2: the remaining 2 ETH.
    assert!(release(escrow, amount: ether(2)) == ether(2))
    assert!(evm.balance(freelancer) == ether(3))
    assert!(available(escrow) == Wei::zero())
    assert!(evm.balance(escrow) == Wei::zero())

    let released: Wei = evm
        .call(
            addr: escrow,
            gas: 100000,
            value: Wei::zero(),
            message: EscrowMsg::Released {},
        )
    assert!(released == ether(3))
}

#[test(balance = 10_000_000_000_000_000_000)]
fn refund_after_deadline_returns_remainder() uses (evm: mut Evm) {
    let client = evm.address()
    let freelancer = Address::new(0x1234)
    // Zero lock: the deadline is right now.
    let escrow = deploy(
        lock: Duration::zero(),
        client: client,
        freelancer: freelancer,
    )

    assert!(fund(escrow, value: ether(2)) == ether(2))
    assert!(available(escrow) == ether(2))

    // The client claws the whole remainder back, to a payout address
    // of their choice (here a fresh address, not the test account: the
    // fe test EVM cannot receive plain value transfers at the test
    // account itself — see NOTES.md).
    let payout = Address::new(0x5678)
    assert!(refund(escrow, to: payout) == ether(2))
    assert!(evm.balance(payout) == ether(2))
    assert!(available(escrow) == Wei::zero())
    assert!(evm.balance(escrow) == Wei::zero())

    let refunded: Wei = evm
        .call(
            addr: escrow,
            gas: 100000,
            value: Wei::zero(),
            message: EscrowMsg::Refunded {},
        )
    assert!(refunded == ether(2))
    // The freelancer never got paid.
    assert!(evm.balance(freelancer) == Wei::zero())
}

#[test(should_revert, balance = 10_000_000_000_000_000_000)]
fn release_after_deadline_reverts() uses (evm: mut Evm) {
    let escrow = deploy(
        lock: Duration::zero(),
        client: evm.address(),
        freelancer: Address::new(0x1234),
    )
    let _ = fund(escrow, value: ether(1))
    let _ = release(escrow, amount: ether(1))
}

#[test(should_revert, balance = 10_000_000_000_000_000_000)]
fn refund_before_deadline_reverts() uses (evm: mut Evm) {
    let escrow = deploy(
        lock: days(7),
        client: evm.address(),
        freelancer: Address::new(0x1234),
    )
    let _ = fund(escrow, value: ether(1))
    let _ = refund(escrow, to: Address::new(0x1234))
}

#[test(should_revert, balance = 10_000_000_000_000_000_000)]
fn second_refund_reverts() uses (evm: mut Evm) {
    let escrow = deploy(
        lock: Duration::zero(),
        client: evm.address(),
        freelancer: Address::new(0x1234),
    )
    let _ = fund(escrow, value: ether(1))
    let _ = refund(escrow, to: Address::new(0x1234))
    let _ = refund(escrow, to: Address::new(0x1234))
}

#[test(should_revert, balance = 10_000_000_000_000_000_000)]
fn only_client_can_fund() uses (evm: mut Evm) {
    // The client is someone else; the test account is a stranger.
    let escrow = deploy(
        lock: days(7),
        client: Address::new(0xbeef),
        freelancer: Address::new(0x1234),
    )
    let _ = fund(escrow, value: ether(1))
}

#[test(should_revert, balance = 10_000_000_000_000_000_000)]
fn only_client_can_release() uses (evm: mut Evm) {
    let escrow = deploy(
        lock: days(7),
        client: Address::new(0xbeef),
        freelancer: Address::new(0x1234),
    )
    let _ = release(escrow, amount: ether(1))
}

#[test(should_revert, balance = 10_000_000_000_000_000_000)]
fn only_client_can_refund() uses (evm: mut Evm) {
    let escrow = deploy(
        lock: Duration::zero(),
        client: Address::new(0xbeef),
        freelancer: Address::new(0x1234),
    )
    let _ = refund(escrow, to: Address::new(0x1234))
}

#[test(should_revert, balance = 10_000_000_000_000_000_000)]
fn zero_fund_reverts() uses (evm: mut Evm) {
    let escrow = deploy(
        lock: days(7),
        client: evm.address(),
        freelancer: Address::new(0x1234),
    )
    let _ = fund(escrow, value: Wei::zero())
}

#[test(should_revert, balance = 10_000_000_000_000_000_000)]
fn zero_release_reverts() uses (evm: mut Evm) {
    let escrow = deploy(
        lock: days(7),
        client: evm.address(),
        freelancer: Address::new(0x1234),
    )
    let _ = fund(escrow, value: ether(1))
    let _ = release(escrow, amount: Wei::zero())
}

#[test(should_revert, balance = 10_000_000_000_000_000_000)]
fn over_release_reverts() uses (evm: mut Evm) {
    let escrow = deploy(
        lock: days(7),
        client: evm.address(),
        freelancer: Address::new(0x1234),
    )
    let _ = fund(escrow, value: ether(1))
    let _ = release(escrow, amount: ether(2))
}

#[test(should_revert, balance = 10_000_000_000_000_000_000)]
fn deploy_rejects_same_parties() uses (evm: mut Evm) {
    let who = evm.address()
    let _ = deploy(lock: days(7), client: who, freelancer: who)
}

#[test(balance = 10_000_000_000_000_000_000)]
fn views_report_state() uses (evm: mut Evm) {
    let client = evm.address()
    let freelancer = Address::new(0x1234)
    let escrow = deploy(lock: days(7), client: client, freelancer: freelancer)
    let _ = fund(escrow, value: ether(5))
    let _ = release(escrow, amount: ether(2))

    let got_client: Address = evm
        .call(
            addr: escrow,
            gas: 100000,
            value: Wei::zero(),
            message: EscrowMsg::Client {},
        )
    assert!(got_client == client)

    let got_freelancer: Address = evm
        .call(
            addr: escrow,
            gas: 100000,
            value: Wei::zero(),
            message: EscrowMsg::Freelancer {},
        )
    assert!(got_freelancer == freelancer)

    let funded: Wei = evm
        .call(
            addr: escrow,
            gas: 100000,
            value: Wei::zero(),
            message: EscrowMsg::Funded {},
        )
    assert!(funded == ether(5))
    assert!(available(escrow) == ether(3))
}
