// Milestone Escrow — trust-minimized freelance payments in Fe.
//
// One escrow per job. The client funds the contract in ETH and releases
// payment milestone by milestone; whatever is still unreleased when the
// deadline passes can be clawed back by the client. No oracle, no dispute
// committee, no token: the deadline is the only arbitrator.
//
// Rules (enforced on-chain):
//   * Only the client can fund, release, or refund.
//   * Funding closes AT the deadline (timestamp <= deadline); a zero
//     deposit is rejected.
//   * Release only works BEFORE the deadline (timestamp < deadline) and
//     only up to the unreleased balance.
//   * Refund only works AT or AFTER the deadline (timestamp >= deadline)
//     and only for the unreleased remainder.
//   * Every state change happens before the ETH transfer (checks-effects-
//     interactions), so a reentrant call finds nothing left to take.

msg EscrowMsg {
    #[selector = sol("fund()")]
    Fund -> Wei,
    #[selector = sol("release(uint256)")]
    Release { amount: Wei } -> Wei,
    #[selector = sol("refund(address)")]
    Refund { to: Address } -> Wei,
    #[selector = sol("client()")]
    Client -> Address,
    #[selector = sol("freelancer()")]
    Freelancer -> Address,
    #[selector = sol("deadline()")]
    Deadline -> Timestamp,
    #[selector = sol("funded()")]
    Funded -> Wei,
    #[selector = sol("released()")]
    Released -> Wei,
    #[selector = sol("refunded()")]
    Refunded -> Wei,
    #[selector = sol("available()")]
    Available -> Wei,
}

#[event]
struct Funded {
    #[indexed]
    from: Address,
    amount: Wei,
    total_funded: Wei,
}

#[event]
struct Released {
    #[indexed]
    to: Address,
    amount: Wei,
    total_released: Wei,
}

#[event]
struct Refunded {
    #[indexed]
    to: Address,
    amount: Wei,
}

pub contract MilestoneEscrow uses (ctx: Ctx, call: mut Call, log: mut Log) {
    client: Address,
    freelancer: Address,
    deadline: Timestamp,
    mut funded: Wei,
    mut released: Wei,
    mut refunded: Wei,

    init(client_addr: Address, freelancer_addr: Address, lock: Duration)
    uses (ctx, mut client, mut freelancer, mut deadline, mut funded, mut released, mut refunded)
    {
        assert!(
            client_addr != freelancer_addr,
            "Client and freelancer must differ",
        )
        // Note: a zero lock is allowed. It makes the deadline "now":
        // funding is still possible at that instant, release is closed,
        // and refund is immediately open. The test suite relies on this
        // to exercise the post-deadline path without time travel.
        client = client_addr
        freelancer = freelancer_addr
        deadline = ctx.timestamp() + lock
        funded = Wei::zero()
        released = Wei::zero()
        refunded = Wei::zero()
    }

    recv EscrowMsg {
        // The client tops up the escrow. Funding is open until the
        // deadline instant itself; after that the money can only move
        // back to the client via `refund`.
        #[payable]
        Fund -> Wei uses (ctx, client, deadline, mut funded, mut log) {
            assert!(ctx.caller() == client, "Only the client can fund")
            assert!(ctx.timestamp() <= deadline, "Funding is closed")
            let amount = ctx.value()
            assert!(amount > Wei::zero(), "Nothing to fund")
            funded = funded + amount
            log.emit(
                Funded { from: ctx.caller(), amount, total_funded: funded },
            )
            funded
        }

        // The client pays out one milestone (or any partial amount) to
        // the freelancer. Only before the deadline, only from the
        // unreleased balance.
        Release { amount } -> Wei uses (
            ctx,
            client,
            mut call,
            freelancer,
            deadline,
            mut released,
            funded,
            refunded,
            mut log,
        ) {
            assert!(ctx.caller() == client, "Only the client can release")
            assert!(ctx.timestamp() < deadline, "Deadline has passed")
            assert!(amount > Wei::zero(), "Nothing to release")
            assert!(
                amount <= funded - released - refunded,
                "Amount exceeds available balance",
            )

            // Effects before interaction: a reentrant call finds the
            // balance already spent.
            released = released + amount
            assert!(
                call.send_value(addr: freelancer, gas: 0, value: amount).success(),
                "Transfer failed",
            )
            log.emit(
                Released { to: freelancer, amount, total_released: released },
            )
            amount
        }

        // After the deadline, the client claws back whatever was never
        // released. The freelancer's window to be paid has closed. The
        // client names the payout address (normally their own wallet),
        // mirroring the starter Vault's `withdraw(address)` pattern.
        Refund { to } -> Wei uses (
            ctx,
            mut call,
            client,
            deadline,
            funded,
            released,
            mut refunded,
            mut log,
        ) {
            assert!(ctx.caller() == client, "Only the client can refund")
            assert!(ctx.timestamp() >= deadline, "Deadline has not passed")
            let amount = funded - released - refunded
            assert!(amount > Wei::zero(), "Nothing to refund")

            refunded = refunded + amount
            assert!(
                call.send_value(addr: to, gas: 0, value: amount).success(),
                "Transfer failed",
            )
            log.emit(Refunded { to, amount })
            amount
        }

        Client -> Address uses (client) {
            client
        }

        Freelancer -> Address uses (freelancer) {
            freelancer
        }

        Deadline -> Timestamp uses (deadline) {
            deadline
        }

        Funded -> Wei uses (funded) {
            funded
        }

        Released -> Wei uses (released) {
            released
        }

        Refunded -> Wei uses (refunded) {
            refunded
        }

        Available -> Wei uses (funded, released, refunded) {
            funded - released - refunded
        }
    }
}
